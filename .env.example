# Template only: copy to .env (same folder as pom.xml) and put the real values THERE.
# .env is git-ignored; this file is committed, so never write real keys in it.
# Spring reads .env through spring.config.import in application.properties.

# PostgreSQL password for the app's database user (required)
DB_PASSWORD=
# Optional overrides; defaults are in application.properties
# DB_URL=jdbc:postgresql://localhost:5432/sos-vietnam-2026-db
# DB_USERNAME=sos_vietnam_2026_db_user

# Signs login tokens (JWT). Random Base64, at least 32 bytes. Generate one with:
#   openssl rand -base64 48
# Changing it logs everyone out.
JWT_SECRET=

# Optional: create admin@sos.vn / dispatcher@sos.vn on first start (skipped when empty).
# Only used if the account doesn't exist yet; change it later in the app, not here.
SEED_ADMIN_PASSWORD=
# Shared password of the test officer accounts in src/main/resources/data/test_accounts.json (empty = not imported)
SEED_TEST_ACCOUNT_PASSWORD=

# local = save to the uploads/ folder | r2 = save to Cloudflare R2
STORAGE_PROVIDER=local
# Cloudflare dashboard > R2 > Overview: Account ID (right column)
R2_ACCOUNT_ID=
# R2 > Overview > API Tokens: Manage > Create Account API token (Object Read & Write, this bucket only)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sos-vietnam-media

# Chỉ để test: true = luôn tạo ca test [DEMO] cho tài khoản test Cần Thơ
DEMO_INCIDENTS=false

# SMS link người phụ trách hiện trường: app "SMS Gateway for Android" (Cloud) trên điện thoại cắm SIM.
# Username / Password hiện trong app sau khi bấm Start. Trống = không gửi SMS.
SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
# Máy 2 SIM: khe gửi (1-3), trống = SIM mặc định
SMS_GATEWAY_SIM=
# Địa chỉ trang web trong link SMS (VPS: https://sosvie.site)
APP_PUBLIC_URL=http://localhost:5173
